generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int                 @id @default(autoincrement())
  nombre         String              @db.VarChar(100)
  contrasena     String              @db.VarChar(255)
  correo         String              @unique @db.VarChar(100)
  fecha_creacion DateTime?           @default(now()) @db.Timestamp(6)
  id_rol         Int?
  asignaciones   AsignacionRecurso[]
  logs_auditoria logs_auditoria[]
  roles          roles?              @relation(fields: [id_rol], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("usuarios")
}

model Proyecto {
  id                String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  codigo            String               @unique @db.VarChar(20)
  nombre            String               @db.VarChar(150)
  descripcion       String?
  estado            estado_proyecto_enum @default(Caso_de_Negocio)
  departamento      String               @db.VarChar(100)
  lider_proyecto    String               @db.VarChar(100)
  presupuesto       Decimal              @default(0.00) @db.Decimal(12, 2)
  costo_real        Decimal              @default(0.00) @db.Decimal(12, 2)
  porcentaje_avance Int                  @default(0)
  fecha_inicio      DateTime             @db.Date
  fecha_fin         DateTime             @db.Date
  creado_en         DateTime?            @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime?            @default(now()) @db.Timestamptz(6)

  @@map("proyectos")
}

model AsignacionRecurso {
  id                    Int       @id @default(autoincrement())
  proyecto_id           String
  usuario_id            Int
  porcentaje_asignacion Int?      @default(100)
  fecha_desde           DateTime? @db.Date
  fecha_hasta           DateTime? @db.Date
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  rol                   String?
  usuario               Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([proyecto_id], map: "idx_asignaciones_proyecto")
  @@index([usuario_id], map: "idx_asignaciones_usuario")
  @@map("asignacion_recursos")
}

model Kpi {
  id            Int                  @id @default(autoincrement())
  proyecto_id   String
  nombre_kpi    String               @db.VarChar(100)
  descripcion   String?
  meta_valor    Decimal?             @db.Decimal(10, 2)
  valor_actual  Decimal?             @default(0.00) @db.Decimal(10, 2)
  unidad_medida String?              @db.VarChar(20)
  created_at    DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  frecuencia    frecuencia_medicion? @default(Mensual)
  historial     HistorialKpi[]

  @@index([proyecto_id], map: "idx_kpis_proyecto")
  @@map("kpis")
}

model HistorialKpi {
  id               Int       @id @default(autoincrement())
  kpi_id           Int
  valor_registrado Decimal   @db.Decimal(10, 2)
  fecha_registro   DateTime? @default(now()) @db.Timestamptz(6)
  usuario_id       Int?
  kpi              Kpi       @relation(fields: [kpi_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kpi_id, fecha_registro], map: "idx_historial_kpi")
  @@map("historial_kpis")
}

model logs_auditoria {
  id                Int       @id @default(autoincrement())
  id_proyecto       String?
  id_usuario_accion Int?
  campo_modificado  String    @db.VarChar(100)
  valor_anterior    String?   @db.VarChar(255)
  valor_nuevo       String?   @db.VarChar(255)
  fecha_transaccion DateTime? @default(now()) @db.Timestamp(6)
  usuarios          Usuario?  @relation(fields: [id_usuario_accion], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model roles {
  id         Int       @id @default(autoincrement())
  nombre_rol String    @unique @db.VarChar(50)
  usuarios   Usuario[]
}

enum EstadoProyecto {
  Idea
  Evaluacion
  Caso_de_Negocio
  Aprobado
  Rechazado
  En_Ejecucion
  En_Pausa
  Completado
  Cancelado
}

enum frecuencia_medicion {
  Semanal
  Mensual
  Trimestral
}

enum estado_proyecto_enum {
  Caso_de_Negocio
  Aprobado
  En_Proceso
  En_Pausa
  Completado
  Cancelado
}
