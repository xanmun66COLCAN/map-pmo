<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pmo_bg_dark"
    android:padding="24dp">

    <!-- Encabezado / Logo -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 MAP"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/pmo_accent"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAP PMO Mobile"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/pmo_text_primary"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Control de Proyectos y Comités"
            android:textSize="12sp"
            android:textColor="@color/pmo_text_secondary"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Formulario de Ingreso -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario / Email"
            android:textSize="12sp"
            android:textColor="@color/pmo_text_secondary"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:hint="ej. admin@mappmo.com"
            android:textColorHint="@color/pmo_text_secondary"
            android:textColor="@color/pmo_text_primary"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textEmailAddress"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="12sp"
            android:textColor="@color/pmo_text_secondary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:hint="••••••••"
            android:textColorHint="@color/pmo_text_secondary"
            android:textColor="@color/pmo_text_primary"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:inputType="textPassword"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Iniciar Sesión"
            android:textColor="@color/pmo_text_primary"
            android:backgroundTint="@color/pmo_primary"
            android:layout_marginTop="24dp"
            android:textAllCaps="false"
            android:textSize="14sp"
            style="?android:attr/borderlessButtonStyle"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/pmo_surface_alt"
            android:layout_marginVertical="20dp"/>

        <Button
            android:id="@+id/btnGuest"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚡ Entrar como Admin (Invitado)"
            android:textColor="@color/pmo_accent"
            android:backgroundTint="@color/pmo_surface"
            android:textAllCaps="false"
            android:textSize="14sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SENA • Análisis y Desarrollo de Software"
        android:textSize="11sp"
        android:textColor="@color/pmo_text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>